# Local development only. Replace these values for any non-local environment.
MYSQL_ROOT_PASSWORD=local-only-root-password
MYSQL_APP_PASSWORD=local-only-app-password
APP_JWT_SECRET=local-only-secret-key-replace-before-deployment-1234567890

# Optional local settings
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_SEED_DEMO_USERS=true
MYTRIP_API_URL=http://localhost:8082
FRONTEND_PORT=3000
BACKEND_PORT=8082

# Local demo accounts are seeded when APP_SEED_DEMO_USERS=true:
# Admin: admin@mytrip.com / admin123
# User:  user@example.com / password123
# Never enable demo users or use these credentials in a public deployment.
