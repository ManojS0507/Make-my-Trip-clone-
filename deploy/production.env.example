# Copy this file to deploy/production.env and replace every placeholder.
# Do not commit deploy/production.env or reuse these example values.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_ROOT_PASSWORD
MYSQL_APP_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_DATABASE_PASSWORD
APP_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
APP_INITIAL_ADMIN_EMAIL=admin@example.com
APP_INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_ADMIN_PASSWORD

# Public browser-facing URLs. Use HTTPS origins in production.
MYTRIP_FRONTEND_URL=https://mytrip.example.com
MYTRIP_API_URL=https://api.mytrip.example.com

# Host ports forwarded by your TLS reverse proxy.
FRONTEND_PORT=3000
BACKEND_PORT=8082
